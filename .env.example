# monolayer-demo-app — environment template.
#
# Monolayer reads the KEY NAMES from this file (never the values) and offers them
# in the Variables tab as keys to fill in. Set real values in Monolayer, not here.
# Comment and blank lines are ignored; everything after `=` is discarded.

# --- App ---
# Port the app listens on. Monolayer injects PORT; the app defaults to 3000 if unset.
PORT=3000

# A plain, non-secret variable — set it in Monolayer and watch it show up (unmasked)
# in the app's "Environment variables" card.
GREETING=hello

# --- Connections (Monolayer injects these when you wire the service on the canvas) ---
# Database: DATABASE_URL (postgres/mysql/mongodb) or REDIS_URL.
DATABASE_URL=postgres://user:password@host:5432/dbname
REDIS_URL=redis://host:6379

# S3 bucket: BUCKET_NAME when one bucket is connected (plus <PREFIX>_BUCKET_NAME each).
BUCKET_NAME=example-bucket
AWS_REGION=us-east-1

# EBS volume: set this to match the mount path you typed in the "Attach volume" dialog.
DEMO_VOLUME_PATH=/data

# --- Parser edge cases (all valid dotenv — the NAMES must still be discovered) ---
export EXPORTED_VAR=exported
SPACED_KEY = spaces-around-equals
EMPTY_VALUE=
QUOTED_VALUE="do not import this value"
