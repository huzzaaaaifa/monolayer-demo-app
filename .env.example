# Monolayer discovers KEY NAMES from this file for the Variables tab.
# Values here are not used in production deploys.

PORT=3000
# Canvas injects AI_PROVIDER and AI_MODEL_ID when connected.
# OpenRouter connections also inject OPENROUTER_MODEL and OPENROUTER_API_KEY.
# Bedrock connections also inject BEDROCK_MODEL_ID and BEDROCK_REGION.
# Locally, use AWS SDK default credentials (for example, an AWS profile) for Bedrock.
# Never put an OpenRouter API key in this file or expose it to browser code.
